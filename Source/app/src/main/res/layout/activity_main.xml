<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- верхняя панель: назад | Podcast Easy / имя папки | экран воспроизведения -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnLeft"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ripple_bar"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings"
            app:tint="@color/icon_top" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/app_title"
            android:textColor="@color/fg"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btnNow"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ripple_bar"
            android:contentDescription="@string/now_playing"
            android:src="@drawable/ic_nowplaying"
            android:visibility="invisible"
            app:tint="@color/icon_top" />

        <!-- режим выбора: «⋮» при одном выбранном, «удалить» при нескольких (вместо кнопки воспроизведения) -->
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ripple_bar"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more"
            android:visibility="gone"
            app:tint="@color/icon_top" />

        <ImageButton
            android:id="@+id/btnSelDel"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ripple_bar"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_delete"
            android:visibility="gone"
            app:tint="@color/icon_top" />
    </LinearLayout>

    <!-- «Записей: N» -->
    <TextView
        android:id="@+id/tvCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAlignment="center"
        android:background="@color/bar_mid"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:textColor="@color/fg_dim"
        android:textSize="13sp" />

    <!-- список с pull-to-refresh -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.r57zone.podcasteasy.PullRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.r57zone.podcasteasy.PullRefreshLayout>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/fg_dim"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
