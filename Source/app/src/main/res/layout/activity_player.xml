<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- action bar: назад | Podcast Easy | удалить -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ripple_bar"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/icon_top" />

        <TextView
            android:id="@+id/tvBarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/fg"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ripple_bar"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_delete"
            app:tint="@color/icon_top" />
    </LinearLayout>

    <!-- папка / название — по центру, мелким шрифтом -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar_mid"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/fg"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- скорость | закладка | список | видео (если есть) | таймер сна. Крайние — у самых краёв, остальные распределены поровну (space-between) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSpeed"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_small"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="1x"
            android:textColor="@color/btn"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnBmAdd"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_small"
            android:contentDescription="@string/bookmark_add"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bm_add"
            app:tint="@color/btn" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnBmList"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_small"
            android:contentDescription="@string/bookmark_list"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bm_list"
            app:tint="@color/btn" />

        <!-- распорка перед видео: прячется вместе с кнопкой -->
        <View
            android:id="@+id/spVideo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnVideo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_small"
            android:contentDescription="@string/video_on"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_video_off"
            android:visibility="gone"
            app:tint="@color/btn" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- таймер сна: обратный отсчёт слева от иконки, иконка у правого края -->
        <LinearLayout
            android:id="@+id/btnSleep"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/ripple_small"
            android:clickable="true"
            android:contentDescription="@string/sleep_timer"
            android:focusable="true"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:visibility="gone" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_timer"
                app:tint="@color/btn" />
        </LinearLayout>
    </LinearLayout>

    <!-- обложка / видео: на всю ширину, по центру свободного места -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.r57zone.podcasteasy.SquareLayout
            android:id="@+id/coverBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="#FF000000">

            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/cover_placeholder" />

            <SurfaceView
                android:id="@+id/surface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- список закладок: вместо обложки, внутри квадрата -->
            <FrameLayout
                android:id="@+id/bmPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bar_mid"
                android:clickable="true"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bmRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:padding="12dp" />

                <TextView
                    android:id="@+id/bmEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/bookmark_empty"
                    android:textColor="@color/fg_dim"
                    android:textSize="15sp" />
            </FrameLayout>
        </com.r57zone.podcasteasy.SquareLayout>
    </FrameLayout>

    <!-- всё ниже прижато к нижнему краю -->
    <!-- время: прошло | полоска | всего (нажатие на «всего» — осталось) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tvPos"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:text="0:00"
            android:textColor="@color/fg_dim" />

        <SeekBar
            android:id="@+id/seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- нажатие: общее время ⇄ осталось (-2:42), без hover-эффекта -->
        <TextView
            android:id="@+id/tvDur"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:gravity="center_vertical|end"
            android:fontFeatureSettings="tnum"
            android:text="0:00"
            android:textColor="@color/fg_dim" />
    </LinearLayout>
    <!-- -30  -10  play/pause  +10  +30 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <ImageButton
            android:id="@+id/btnRew30"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ripple_small"
            android:contentDescription="-30"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_rew30"
            app:tint="@color/btn" />

        <ImageButton
            android:id="@+id/btnRew10"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ripple_small"
            android:contentDescription="-10"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_rew10"
            app:tint="@color/btn" />

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/ripple_play"
            android:contentDescription="@string/act_play"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            app:tint="@color/btn" />

        <ImageButton
            android:id="@+id/btnFwd10"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ripple_small"
            android:contentDescription="+10"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_fwd10"
            app:tint="@color/btn" />

        <ImageButton
            android:id="@+id/btnFwd30"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ripple_small"
            android:contentDescription="+30"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_fwd30"
            app:tint="@color/btn" />
    </LinearLayout>

    <!-- [тише] ——— полоска ——— [громче]: кнопки идут по уровням 1…10, 15, 20 … 100 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnVolDown"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ripple_vol"
            android:contentDescription="@string/volume"
            android:src="@drawable/ic_volume_low"
            app:tint="@color/btn" />

        <SeekBar
            android:id="@+id/seekVol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:min="1"
            android:max="100"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnVolUp"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ripple_vol"
            android:contentDescription="@string/volume"
            android:src="@drawable/ic_volume"
            app:tint="@color/btn" />
    </LinearLayout>

    <!-- мелкая полоска: тап — показать/скрыть формат (слева) и битрейт или разрешение (справа); громкость по центру -->
    <LinearLayout
        android:id="@+id/infoStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="14dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tvFmt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:singleLine="true"
            android:textColor="@color/fg_faint"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_volume"
            app:tint="@color/fg_faint" />

        <TextView
            android:id="@+id/tvVol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/fg_faint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:singleLine="true"
            android:textColor="@color/fg_faint"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
