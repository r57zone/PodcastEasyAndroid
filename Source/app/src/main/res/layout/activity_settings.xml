<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- action bar: назад | Настройки -->
	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="56dp"
		android:background="@color/bar">

		<ImageButton
			android:id="@+id/btnBack"
			android:layout_width="56dp"
			android:layout_height="56dp"
			android:layout_gravity="start|center_vertical"
			android:background="@drawable/ripple_bar"
			android:contentDescription="@string/back"
			android:src="@drawable/ic_back"
			app:tint="@color/icon_top" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center"
			android:text="@string/settings"
			android:textColor="@color/fg"
			android:textSize="18sp" />

	</FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. папка подкастов -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/podcasts_folder"
                android:textColor="@color/fg_dim" />

            <TextView
                android:id="@+id/tvFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/fg"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnChoose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/choose_folder" />

            <Button
                android:id="@+id/btnDefault"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reset_folder" />

            <Button
                android:id="@+id/btnAccess"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grant_access" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider" />

            <!-- 2. воспроизведение -->
            <CheckBox
                android:id="@+id/cbAutoplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/autoplay"
                android:textColor="@color/fg" />

            <CheckBox
                android:id="@+id/cbNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/play_next"
                android:textColor="@color/fg" />

            <CheckBox
                android:id="@+id/cbAutoVideo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_video"
                android:textColor="@color/fg" />

            <CheckBox
                android:id="@+id/cbCoverFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cover_file"
                android:textColor="@color/fg" />

            <CheckBox
                android:id="@+id/cbHideBookmarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hide_bookmarks"
                android:textColor="@color/fg" />

            <CheckBox
                android:id="@+id/cbDelBookmarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/always_delete_bookmarks"
                android:textColor="@color/fg" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider" />

            <!-- 3. язык и тема -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language"
                android:textColor="@color/fg_dim" />

            <Button
                android:id="@+id/btnLang"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/theme"
                android:textColor="@color/fg_dim" />

            <Button
                android:id="@+id/btnTheme"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sound"
                android:textColor="@color/fg_dim" />

            <Button
                android:id="@+id/btnSound"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider" />

            <!-- 4. прогресс: импорт / экспорт -->
            <Button
                android:id="@+id/btnImport"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_progress" />

            <Button
                android:id="@+id/btnExport"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_progress" />

            <!-- прижато к низу экрана -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_title"
                    android:textColor="@color/fg"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/fg_dim"
                    android:textSize="13sp" />

                <!-- маленькие одинаковые кнопки-ссылки (строятся в SettingsActivity.buildLinks) -->
                <LinearLayout
                    android:id="@+id/links"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
